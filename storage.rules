rules_version = '2';
// Meter photos, signed agreements and statement PDFs. Team members only (tenants open statements through their link).
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (folder == 'uploads' || folder == 'statements')
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
